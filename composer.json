{
    "name": "omnimeet/jitsi",
    "type": "library",
    "description": "Omnimeet Jitsi: a video meeting on a Jitsi Meet instance - one's own, a public one, or 8x8's Jitsi as a Service - embedded through the IFrame API and driven from the page, a JSON Web Token per participant (shared secret or key pair), several people, JaaS webhooks read and their signature checked.",
    "keywords": [
        "video",
        "meeting",
        "conference",
        "jitsi",
        "jitsi-meet",
        "jaas",
        "jwt",
        "omnimeet",
        "usage-policy"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnimeet-jitsi",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/omnimeet": "^1.0"
    },
    "require-dev": {
        "ext-openssl": "*",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-openssl": "Tokens signed with a private key (RS256): Jitsi as a Service, or an instance that validates against a public key server"
    },
    "autoload": {
        "psr-4": {
            "Omnimeet\\Jitsi\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnimeet\\Jitsi\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "omnisense": {
            "policies": [
                "policy.json",
                "policy-meet-jit-si.json",
                "policy-jaas.json"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
